# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Data is downloaded by the pipeline, never committed
data/*
!data/.gitkeep

# Model weights: only the final model (used by the API) and the settings files are committed.
# scratch.keras failed the quality gate, so it stays out.
models/*
!models/.gitkeep
!models/pretrained.keras
!models/*.json

# Experiment tracking: the runs from Colab (mlflow.db, 1 MB) are committed for docker-compose
mlruns/
mlartifacts/

# Private progress checklist, not part of the submission
docs/ROADMAP.md
docs/SLIDES_GUIDE.md
docs/SLIDE_BRIEF.pdf
docs/slide_brief_figures/

# Editors / OS
.vscode/
.claude/
.ipynb_checkpoints/
Thumbs.db
.DS_Store
